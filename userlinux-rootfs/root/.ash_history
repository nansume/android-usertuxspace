: ls /
apk update
apk search dropbear
apk add dropbear dropbear-scp mc busybox busybox-extras nano nano-syntax
: apk add inetutils-telnet busybox-openrc
: nc -lk -p 2323 -e sh
nc -l -p 2323 > /etc/inetd.conf
nc -l -p 2323 > /etc/dropbear/dropbear_ed25519_host_key
nc -l -p 2323 > /root/.ssh/authorized_keys
mkdir /root/.ssh/ /var/www/
chmod 600 /root/.ssh/authorized_keys /etc/dropbear/dropbear_ed25519_host_key
export EDITOR=nano
nano /etc/inetd.conf
: nano /root/.ash_history
nano /etc/nanorc
nano /usr/share/nano/sh.nanorc
mc
: cat /etc/inetd.conf
: inetd /etc/inetd.conf
: pgrep inetd
: killall inetd
: rc-status --all
: rc-update add 'dropbear' boot
: nano /etc/conf.d/dropbear
: touch /run/openrc/softlevel
: /etc/init.d/dropbear start
: command -v dropbear
: kill 12345
: dropbear -r /etc/dropbear/dropbear_ed25519_host_key -p 2222 -j -k -s -T 2
nano /root/.profile
ps -o args | head | grep -om1 "dropbear"
INITIAL_USERNAME=<user> /support/startVNCServer.sh
killall Xvfb
nc -n -z 0.0.0.0 2053 && echo "open port"

echo "/bin/false" >> /etc/shells
