: ls /
apk update
apk search nano
apk add dropbear-scp mc busybox-extras nano nano-syntax
: apk add inetutils-telnet
apk add ustream-ssl -s  # install simulation
: nc -lk -p 2323 -e sh
nc -l -p 2323 > /etc/inetd.conf
nc -l -p 2323 > /etc/dropbear/dropbear_ed25519_host_key
nc -l -p 2323 > /root/.ssh/authorized_keys
mkdir /root/.ssh/ /var/www/ /var/www/localhost/
chmod 600 /root/.ssh/authorized_keys /etc/dropbear/dropbear_ed25519_host_key
export EDITOR=nano
nano /etc/inetd.conf
: nano /root/.ash_history
nano /etc/nanorc
mc
: cat /etc/inetd.conf
: inetd /etc/inetd.conf
: command -v dropbear
: kill -15 12345
: dropbear -r /etc/dropbear/dropbear_ed25519_host_key -p 2222 -j -k -s -T 2
nano /root/.profile
ps -o args | head | grep -om1 "dropbear"

java -version
fuser -4 /etc/hosts

: ln -sf /bin/busybox /bin/hostname

echo "${s#${s%%[^0-9]*}}"; echo "${s#${s%%[!0-9]*}}"

getent hosts google.com
domain-name
busybox hostname -f
nslookup google.com 1.1.1.1
nc -w 1 -i 1 -v -n 1.1.1.1 100 && echo ok
nc -w1 -n -z 0.0.0.0 2053 && echo "open port"
wget -T1 --spider -qSO - http://192.168.0.1:80/gatedesc.xml && echo open

sping -c1 1.1.1.1
ping -4c1 192.168.0.1
http_ping -count 3 -interval 2 http://google.com
http_ping -count 3 -interval 2 http://1.1.1.1
ip route show default

netgw
netdev-ip
ext-ip

echo "/bin/false" >> /etc/shells

SAVE_ULIMIT_UPROC=$(ulimit -Su)
(ulimit -S -u 200; inetd /etc/inetd.conf)
router-show-portmap
tcpdmatch ssh@0.0.0.0 192.168.0.10
tcpdmatch ssh ::1
arch
gcc -V
apk add patch build-base
/usr/local/ports/sslh_build.sh
ldd /usr/local/sbin/sslh-ev
/etc/local.d/sslh.start
tail -f /var/log/sslh.log
: >/var/log/sslh.log
: pgrep -x sslh-ev
: killall sslh-ev

: /usr/local/ports/http-ping_build.sh
