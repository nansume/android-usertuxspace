#!/bin/sh
# /etc/local.d/yacy.start

JAVA="java"

# home-directory
YACY_HOME="/usr/share/yacy"

# user to run yacy as
YACY_USER="yacy"

# java options (optional)
JAVA_OPTIONS="-Xmx600m -Xms180m"

# niceness (optional)
NICENESS="19"

# wait on stop, should be maxWaitingWordFlush, see DATA/SETTINGS/httpProxy.conf
WAIT_ON_STOP="180"

pgrep -f "^java .* -classpath classes:htroot:lib/" >/dev/null && exit

cd ${YACY_HOME}/

JAVA_ARGS=""
if [ -e DATA/SETTINGS/httpProxy.conf ] ; then
  for i in $(grep javastart DATA/SETTINGS/httpProxy.conf); do
    i="${i#javastart_*=}";
    JAVA_ARGS=-$i" "$JAVA_ARGS;
  done
fi

CLASSPATH=""
test -e lib/ && for N in lib/*.jar; do CLASSPATH="${CLASSPATH}${N}:"; done
CLASSPATH="-classpath classes:htroot:${CLASSPATH}"

if [ -n "${NICENESS}" ] ; then
  NICE="nice -n ${NICENESS}"
fi

pre_start() {
  for LOG in /usr/share/yacy/DATA/LOG/*; do
    case ${LOG} in *'/yacy.logging') continue;; esac
    [ -f "${LOG}" ] && rm "${LOG}"
  done
  for TMPFILE in /tmp/yacy-tmp-*; do
    [ -d "${TMPFILE}" ] && rm -r -- "${TMPFILE}"
  done
}

start() {
  #set -x
  echo "Starting YaCy"
  ${NICE} su ${YACY_USER} -c "${JAVA} ${JAVA_OPTIONS} ${JAVA_ARGS} ${CLASSPATH} net.yacy.yacy" &
  echo "${NICE} su ${YACY_USER} -c '${JAVA} ${JAVA_OPTIONS} ${JAVA_ARGS} \${CLASSPATH} net.yacy.yacy &'"
  echo $! > /var/run/yacy.pid
  sleep 1
  ps ax | grep "^ *$(cat /var/run/yacy.pid)" >/dev/null
  return $?
}

pre_start
start
