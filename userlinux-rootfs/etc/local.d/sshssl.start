#!/bin/sh
# /etc/local.d/sshssl.start

# TIP!: echo /bin/false >> /etc/shells

DAEMON_RUN="autossh"
SSH_USER="root"
SSH_HOME="/root"
AUTH_USER=$(head -n1 /etc/sysconfig/ssh-client/auth_user)
AUTH_FILE=$(head -n1 /etc/sysconfig/ssh-client/auth_pass)
SSH_PORT=$(head -n1 /etc/sysconfig/ssh-client/ssh_port)
DOMAINNAME=$(head -n1 /etc/sysconfig/ssh-client/domain)
DOMAINNAME=$(hosttoip ${DOMAINNAME:?})
LOGFILE="/var/log/${DAEMON_RUN}.log"

SSH_PORT="8022"
DOMAINNAME="127.0.0.1"

export AUTOSSH_PATH="/usr/bin/dbclient"
export AUTOSSH_GATETIME="0"

pgrep -x ${DAEMON_RUN} >/dev/null && exit
pgrep -x "dbclient" >/dev/null && exit
pgrep -x "stunnel" >/dev/null || exit 0
nc -w1 -n -z 0.0.0.0 3130 && exit

>> "${LOGFILE}"
chown ${SSH_USER}:${SSH_USER} "${LOGFILE}"

DROPBEAR_PASSWORD=$(head -n1 ${AUTH_FILE}) \
${DAEMON_RUN} \
  -M 0 -f -o "ServerAliveInterval 60" -o "ServerAliveCountMax 3" \
  -i ${SSH_HOME}/.ssh/id_dropbear_tunnel \
  -R 127.0.0.1:2324:127.0.0.1:2323 \
  -R 127.0.0.1:2223:127.0.0.1:2222 \
  -R 127.0.0.1:5901:127.0.0.1:5900 \
  -N -p ${SSH_PORT} \
  ${AUTH_USER}@${DOMAINNAME} >> ${LOGFILE} 2>&1
