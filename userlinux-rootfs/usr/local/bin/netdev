#!/bin/sh
# ----------------------------------------
# File: /bin/netdev
# ----------------------------------------
# Usage: NETDEV=$(netdev); IF=$(netdev)
# Depend: route/ip,nc(netcat)
# ----------------------------------------
# Date: 2026-08-29 11:00 UTC - last change
# ----------------------------------------
set -e -u -f

IFS="$(printf '\n\t')"
OLDIFS=${IFS}
runuser=${USER_NET:-nobody}

print_help() {
  cat >&2 <<_EOF_
Usage: ${0##*/} -u USER

Options:
  -u  user (drop privileges)
  -h  Print usage help and exit
_EOF_

exit 1
}

case $(id -un) in
  'root')
    IFS=" " ARG=${@}; IFS=${OLDIFS}
    while [ x"${1-}" != x ]; do
      case ${1-} in
        -u) runuser=${2:?required user}; shift;;
        -h) print_help;;
      esac
      shift
    done
    [ -n "${runuser-}" ] || exit 1

    su ${runuser} -c "${0##*/} ${ARG}";
    exit $?
  ;;
esac

while [ x"${1-}" != x ]; do
  case ${1} in
    -u) shift;;
    -h) print_help;;
     *) print_help;;
  esac
  shift
done

for s in $(ip route show default) $(route -A inet -n) $(ifconfig) eth0; do
  [ -n "${s%%[[:space:]]*}" ] || continue
  IFS="$(printf '\n\t%1s')"; set -- ${s:-''}
  case ${1} in
    'lo'|'teredo'|'sit0'|'tun0') continue;;
    'default'|'0.0.0.0'|*'.0') set -- ${8}; break;;
  esac
  case ${2-} in
    'Link') set -- ${1}; break;;
    'dev')
      case ${3} in 'lo'|'teredo'|'sit0'|'tun0') continue;; esac
      set -- ${3}; break;;
  esac
done 2>/dev/null

set -- "${1#${1%%[![:space:]]*}}"
if=${1%% *}; case ${if} in *?) if="${if%.*}";; esac  # netdev

printf '%s\n' "${if}"
