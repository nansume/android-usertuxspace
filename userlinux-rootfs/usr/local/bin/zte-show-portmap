#!/bin/sh
# File: /bin/zte-router-portmap
# Name: zte-router-portmap
# Description: For ZTE Router ZXHN E5502
# Version: v0.1.2025.11.11
# Usage: PORTMAPLIST=$(zte-router-portmap)
# Date: 2025-11-26 12:00 UTC, 2026-07-24 14:00 UTC
set -u -f

IFS="$(printf '\n\t')"; IFS=${IFS%?}
USER_NET=$(head -n1 /etc/sysconfig/netuser 2>/dev/null || echo nobody)
ADMIN_USER=$(head -n1 /etc/sysconfig/router/login 2>/dev/null || echo admin)
ADMIN_PASS=$(head -n1 /etc/sysconfig/router/passwd 2>/dev/null || echo admin)
bb=$(command -v "busybox" ||:)

groups ${USER_NET} >/dev/null 2>&1 && {
case $(id -un) in
  "${USER_NET}");;  # It support user, otherwise exit.
  'root') su ${USER_NET} -c "${0##*/}"; exit;;
  'root'|*) printf '%s\n' "${0##*/}: wrong user... error" >&2; exit 1;;
esac
}

GW=$(netdev-gw)
GW_HOST=${GW}
REFERER="http://${GW_HOST}/getpage.lua?pid=1002&nextpage=Internet_PortForwarding_t.gch"

#FIX: error: private iprange: Permission denied
if ${bb} nc -w1 -n -z ${GW_HOST} '80' 2>/dev/null || { EXT_IP=$(ext-ip); false; }; then
  true
elif ${bb} nc -w1 -n -z ${EXT_IP} '80' 2>/dev/null; then
  GW_HOST=${EXT_IP}
fi

${bb} wget \
  -q --spider --post-data "action=login&Username=${ADMIN_USER}&Password=${ADMIN_PASS}" \
  -O - "http://${GW_HOST}/getpage.lua?pid=1002&nextpage=Internet_PortForwarding_t.gch" \
  >/dev/null 2>&1

printf %s\\n " i protocol  exPort->inAddr%inPort      description    enable"
INDEX="-1"
# return list for portforward mapping
${bb} wget \
  -q --header "'Referer: ${REFERER}'" \
  -O - "http://${GW_HOST}/common_page/PortForwarding_lua.lua" | sed \
  -e "s|><Instance>|>\n<Instance>|g;s|</Instance><|</Instance>\n<|" \
  -e "s|.*><OBJ_FWPM_ID>\n||;s|^</OBJ_FWPM_ID><.*||" \
 | while IFS= read -r S; do  # Here child proc.

  [ -n "${S}" ] || continue

  case ${S} in
    *'<ParaName>Protocol</ParaName><ParaValue>0</ParaValue>'*) PROTO="TCP";;
    *'<ParaName>Protocol</ParaName><ParaValue>1</ParaValue>'*) PROTO="UDP";;
  esac

  case ${S} in
    *'<ParaName>Name</ParaName>'*)
      #INDEX=" $(expr "${INDEX:-0}" + '1')"
      INDEX=${S#*<ParaName>_InstID</ParaName><ParaValue>}; INDEX=${INDEX%%</ParaValue>*}
      INDEX=" ${INDEX#IGD.FWPM}"
      INDEX="${INDEX#${INDEX%??}}"

      RPORT0=${S#*<ParaName>MinExtPort</ParaName><ParaValue>}; RPORT0=${RPORT0%%</ParaValue>*}
      RPORT1=${S#*<ParaName>MaxExtPort</ParaName><ParaValue>}; RPORT1=${RPORT1%%</ParaValue>*}
      LANIP=${S#*<ParaName>InternalHost</ParaName><ParaValue>}; LANIP=${LANIP%%</ParaValue>*}
      LPORT0=${S#*<ParaName>MinIntPort</ParaName><ParaValue>}; LPORT0=${LPORT0%%</ParaValue>*}
      LPORT1=${S#*<ParaName>MaxIntPort</ParaName><ParaValue>}; LPORT1=${LPORT1%%</ParaValue>*}
      DESC=${S#*<ParaName>Name</ParaName><ParaValue>}; DESC=${DESC%%</ParaValue>*}
      ENABLE=${S#*<ParaName>Enable</ParaName><ParaValue>}; ENABLE=${ENABLE%%</ParaValue>*}

      RPORT="          ${RPORT0}:${RPORT1}"; RPORT="${RPORT#${RPORT%???????????}}"
      LPORT="${LPORT0}:${LPORT1}          "; LPORT="${LPORT%${LPORT#???????????}}"
      DESC="${DESC}               "; DESC="${DESC%${DESC#???????????????}}"

      printf %s\\n "${INDEX} ${PROTO} ${RPORT}->${LANIP}%${LPORT} ${DESC} ${ENABLE}"
    ;;
  esac

done
