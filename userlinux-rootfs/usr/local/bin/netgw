#!/bin/sh
# ----------------------------------------
# File: /bin/netgw
# ----------------------------------------
# Usage: GATEWAY=$(netgw)
# Optional: export USER_NET=<user-network>
# Depend: route/ip,nc(netcat)
# ----------------------------------------
# Date: 2026-07-10 14:00 UTC - last change
# ----------------------------------------
set -e -u -f

IFS="$(printf '\n\t')"
OLDIFS=${IFS}
runuser=${USER_NET:-nobody}

print_help() {
  cat >&2 <<_EOF_
Usage: ${0##*/} -u USER

Options:
  -u  user (drop privileges)
  -h  Print usage help and exit
_EOF_

exit 1
}

case $(id -un) in
  'root')
    IFS=" " ARG=${@}; IFS=${OLDIFS}
    while [ x"${1-}" != x ]; do
      case ${1-} in
        -u) runuser=${2:?required user}; shift;;
        -h) print_help;;
      esac
      shift
    done
    [ -n "${runuser-}" ] || exit 1

    su ${runuser} -c "${0##*/} ${ARG}";
    exit $?
  ;;
esac

while [ x"${1-}" != x ]; do
  case $1 in
    -u) shift;;
    -h) print_help;;
     *) print_help;;
  esac
  shift
done

if command -v ip >/dev/null; then
  for route in $(ip route show default 2>/dev/null) ''; do
    IFS="$(printf '\n\t%1s')"; set -- ${route:-''}
    case ${1} in
      'default') set -- ${3}; break;;
      '172.19.'*|'172.19.'*' tun0 '*) continue;;  # FIX for Android
      *'.0/'[0-9]*) set -- ${1%/*}; break;;
      *) set -- ${1%/*}; break;;
    esac
  done
else
  set -- $(route -A inet -n)
  case ${3} in "0.0.0.0 "*) set -- ${3#* };; *) set -- ${3%% *};; esac
fi
set -- "${1#${1%%[![:space:]]*}}"
gw=${1%% *}; case ${gw} in *".0") gw="${gw%.*}.1";; esac  # gateway

#FIX: error: ip: bind: Permission denied
case ${gw} in " "|"")
  if nc -w 1 -n -z 192.168.1.1 80; then
    gw="192.168.1.1"
  elif nc -w 1 -n -z 192.168.0.1 80; then
    gw="192.168.0.1"
  fi
;;
esac

printf '%s\n' "${gw}"
