# /usr/share/nano/css.nanorc

## Syntax highlighting for CSS files.

syntax css "\.css$"
comment "/*|*/"

# First make everything red:
color red     "."
# Then everything between braces yellow:
color yellow  start="\{" end="\}"
# Then everything after a colon white:
color magenta   start=":" end="([;^{]|$)"

# Pseudo-classes:
color cyan   ":(active|checked|focus|hover|link|visited|after|before)\>"

# Comments:
color blue    start="/\*" end="\*/"

# Syntactic characters:
color green         ";|:|\{|\}"
